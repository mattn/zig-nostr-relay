.{
    .name = .zig_nostr_relay,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "0.0.0",

    .fingerprint = 0x77292172587e62fd, // Changing this has security and trust implications.
    // This field is optional.
    // This is currently advisory only; Zig does not yet do anything
    // with this value.
    //.minimum_zig_version = "0.11.0",

    // This field is optional.
    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package, recursively.
    // Once all dependencies are fetched, `zig build` no longer requires
    // internet connectivity.
    .dependencies = .{
        .websocket = .{
            .url = "https://github.com/karlseguin/websocket.zig/archive/91ca9c501066144fa95a52237da110812e9aa145.tar.gz",
            .hash = "122006b3387ad84a51b68431bbcc1bd4c48c548e8ec34a36766c899a1c4dfa83419b",
        },
        .pg = .{
            .url = "https://github.com/karlseguin/pg.zig/archive/f8d4892387fbad2abdf775783e101e50a7114335.tar.gz",
            .hash = "1220ff40066b3e134d106a6751947f2c490a4f8d14adade9fb8c97f0d30046f61914",
        },
        .struct_env = .{
            .url = "https://github.com/Hanaasagi/struct-env/archive/4934ca86f3fcbc0500cc4ee65255943a2fa479e4.tar.gz",
            .hash = "12207a0c5cd1249c4cda5b9aec96102458b25e7f540b56c20c540c2f70620d848f88",
        },
    },

    // Specifies the set of files and directories that are included in this package.
    // Only files and directories listed here are included in the `hash` that
    // is computed for this package.
    // Paths are relative to the build root. Use the empty string (`""`) to refer to
    // the build root itself.
    // A directory listed here means that all files within, recursively, are included.
    .paths = .{
        // This makes *all* files, recursively, included in this package. It is generally
        // better to explicitly list the files and directories instead, to insure that
        // fetching from tarballs, file system paths, and version control all result
        // in the same contents hash.
        "",
        // For example...
        "build.zig",
        "build.zig.zon",
        "src",
        //"LICENSE",
        "README.md",
    },
}
